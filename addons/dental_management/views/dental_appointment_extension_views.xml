<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_form_inherit_management" model="ir.ui.view">
        <field name="name">dental.appointment.form.inherit.management</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="dental_core.view_dental_appointment_form"/>
        <field name="arch" type="xml">
            <field name="dentist_id" position="after">
                <field name="chair_id"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Tooth Chart Records">
                    <field name="tooth_record_ids">
                        <list editable="bottom">
                            <field name="tooth_number"/>
                            <field name="condition"/>
                            <field name="treatment_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
                <page string="Prescriptions">
                    <field name="prescription_ids">
                        <list string="Prescriptions">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="dentist_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_dental_appointment_tree_inherit_management" model="ir.ui.view">
        <field name="name">dental.appointment.list.inherit.management</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="dental_core.view_dental_appointment_tree"/>
        <field name="arch" type="xml">
            <field name="dentist_id" position="after">
                <field name="chair_id"/>
            </field>
        </field>
    </record>
</odoo>
