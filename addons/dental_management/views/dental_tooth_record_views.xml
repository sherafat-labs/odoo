<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_tooth_record_tree" model="ir.ui.view">
        <field name="name">dental.tooth.record.list</field>
        <field name="model">dental.tooth.record</field>
        <field name="arch" type="xml">
            <list string="Tooth Records">
                <field name="patient_id"/>
                <field name="tooth_number"/>
                <field name="condition"/>
                <field name="treatment_id"/>
                <field name="appointment_id"/>
            </list>
        </field>
    </record>

    <record id="view_dental_tooth_record_form" model="ir.ui.view">
        <field name="name">dental.tooth.record.form</field>
        <field name="model">dental.tooth.record</field>
        <field name="arch" type="xml">
            <form string="Tooth Record">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="tooth_number"/>
                            <field name="condition"/>
                        </group>
                        <group>
                            <field name="appointment_id"/>
                            <field name="treatment_id"/>
                        </group>
                    </group>
                    <group string="Notes &amp; Treatment Plan">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_tooth_record" model="ir.actions.act_window">
        <field name="name">Tooth Chart Records</field>
        <field name="res_model">dental.tooth.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dental_clinical_root" name="Clinical Records" parent="dental_core.menu_dental_root" sequence="15"/>
    <menuitem id="menu_dental_tooth_record" name="Tooth Chart Records" parent="menu_dental_clinical_root" action="action_dental_tooth_record" sequence="10"/>
</odoo>
