<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_prescription_tree" model="ir.ui.view">
        <field name="name">dental.prescription.list</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="date"/>
                <field name="appointment_id"/>
            </list>
        </field>
    </record>

    <record id="view_dental_prescription_form" model="ir.ui.view">
        <field name="name">dental.prescription.form</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="dentist_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="appointment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescribed Medications">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="medicine_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes / Instructions">
                            <field name="notes" placeholder="General advice or additional instructions..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">dental.prescription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dental_prescription" name="Prescriptions" parent="menu_dental_clinical_root" action="action_dental_prescription" sequence="20"/>
</odoo>
