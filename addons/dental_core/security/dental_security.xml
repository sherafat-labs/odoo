<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dental" model="ir.module.category">
        <field name="name">Dental Clinic Management</field>
        <field name="description">Category for Dental Clinic plugins</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dental_user" model="res.groups">
        <field name="name">User / Staff</field>
        <field name="category_id" ref="module_category_dental"/>
    </record>

    <record id="group_dental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_dental_user'))]"/>
    </record>
</odoo>
