<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_treatment_tree" model="ir.ui.view">
        <field name="name">dental.treatment.list</field>
        <field name="model">dental.treatment</field>
        <field name="arch" type="xml">
            <list string="Dental Treatments">
                <field name="code"/>
                <field name="name"/>
                <field name="duration" widget="float_time"/>
                <field name="cost"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dental_treatment_form" model="ir.ui.view">
        <field name="name">dental.treatment.form</field>
        <field name="model">dental.treatment</field>
        <field name="arch" type="xml">
            <form string="Treatment Catalog">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="duration" widget="float_time"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Treatment procedures & details..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_treatment" model="ir.actions.act_window">
        <field name="name">Treatments Catalog</field>
        <field name="res_model">dental.treatment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create dental treatments and pricing!
            </p>
        </field>
    </record>
</odoo>
