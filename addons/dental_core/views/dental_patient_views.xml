<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_patient_tree" model="ir.ui.view">
        <field name="name">dental.patient.list</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="blood_group"/>
            </list>
        </field>
    </record>

    <record id="view_dental_patient_form" model="ir.ui.view">
        <field name="name">dental.patient.form</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_dental_appointment_patient)d" type="action" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                        <group string="Medical Profile">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medical History">
                            <field name="medical_history" placeholder="Enter patient's medical history..."/>
                        </page>
                        <page string="Allergies">
                            <field name="allergies" placeholder="Enter known allergies..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">dental.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new patient!
            </p>
        </field>
    </record>
</odoo>
